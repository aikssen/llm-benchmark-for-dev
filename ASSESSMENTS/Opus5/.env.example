# Every setting is optional: the service runs with no configuration at all.
# The values shown here are the defaults.
#
# Load them with:  set -a && source .env.example && set +a && make run

# --- HTTP server -------------------------------------------------------------
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# Bounds how long a single handler may run.
SERVER_REQUEST_TIMEOUT=10s
# How long shutdown waits for in-flight requests and the queue backlog.
SERVER_SHUTDOWN_TIMEOUT=20s
SERVER_MAX_REQUEST_BYTES=1048576

# --- Processing --------------------------------------------------------------
# The cap on concurrent deliveries, and therefore on concurrent provider calls.
WORKER_COUNT=16
# How much burst is absorbed before the service starts shedding with a 429.
QUEUE_CAPACITY=4096
# Must not exceed QUEUE_CAPACITY, or such a request could never be admitted.
MAX_RECIPIENTS_PER_REQUEST=1000

# --- Simulated providers -----------------------------------------------------
# Bounds a single provider call, so one slow dependency cannot pin a worker.
PROVIDER_CALL_TIMEOUT=3s
PROVIDER_MIN_LATENCY=20ms
PROVIDER_MAX_LATENCY=250ms
# Probability of a retryable failure. Set to 1 to simulate a full outage.
PROVIDER_TRANSIENT_FAILURE_RATE=0.15
# Probability of the provider rejecting the message outright (never retried).
PROVIDER_PERMANENT_FAILURE_RATE=0.02

# --- Retries -----------------------------------------------------------------
# Total tries, including the first.
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_BACKOFF=100ms
RETRY_MAX_BACKOFF=2s
RETRY_MULTIPLIER=2
# Fraction of the delay randomised, so simultaneous failures do not retry
# in lockstep and recreate the spike.
RETRY_JITTER=0.2

# --- Circuit breaker (per provider) ------------------------------------------
# Consecutive transient failures that trip the breaker. 0 disables it.
BREAKER_FAILURE_THRESHOLD=10
BREAKER_OPEN_DURATION=5s
BREAKER_HALF_OPEN_MAX_CALLS=2
BREAKER_SUCCESS_THRESHOLD=2

# --- Rate limiting (per recipient, per channel) ------------------------------
# 0 disables limiting.
RATE_LIMIT_RATE=60
RATE_LIMIT_INTERVAL=1m
RATE_LIMIT_BURST=10

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text  ("text" is easier to read during local development)
LOG_FORMAT=json
