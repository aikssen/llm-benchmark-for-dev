# Example environment configuration for the notification service.
# Every value has a built-in default; set only what you need to override.
# Copy to .env and `source` it, or export selectively before `make run`.

# --- HTTP server ---
NS_ADDR=:8080
NS_READ_TIMEOUT=5s
NS_WRITE_TIMEOUT=10s
NS_SHUTDOWN_TIMEOUT=15s
# Max time a submit may block while the worker queue is full (backpressure).
NS_SUBMIT_TIMEOUT=2s

# --- Worker pool ---
# Number of concurrent workers and the bounded queue capacity. Together these
# cap resource usage under bursty load.
NS_WORKERS=8
NS_QUEUE_SIZE=1024

# --- Delivery reliability ---
NS_MAX_ATTEMPTS=4
NS_BASE_BACKOFF=100ms
NS_MAX_BACKOFF=5s
NS_ATTEMPT_TIMEOUT=3s
# Circuit breaker: open after N consecutive failures, probe again after cooldown.
NS_CB_MAX_FAILURES=5
NS_CB_COOLDOWN=10s

# --- Rate limiting (per recipient, per channel) ---
# Set NS_RATE_LIMIT=0 to disable.
NS_RATE_LIMIT=20
NS_RATE_LIMIT_WINDOW=1m

# --- Simulated providers (for local demo of unreliable upstreams) ---
# Probability [0,1] of a transient (retryable) failure per send.
NS_PROVIDER_FAILURE_RATE=0.2
# Probability [0,1] of a permanent (non-retryable) failure per send.
NS_PROVIDER_PERMANENT_RATE=0.02
NS_PROVIDER_MIN_LATENCY=10ms
NS_PROVIDER_MAX_LATENCY=150ms
