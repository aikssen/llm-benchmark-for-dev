# Server
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s

# Worker pool
WORKER_COUNT=8
QUEUE_SIZE=256
MAX_ATTEMPTS=4
BASE_BACKOFF=100ms
MAX_BACKOFF=2s
PER_ATTEMPT_TIMEOUT=5s

# Rate limiting
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SEC=1

# Storage sweeper
SWEEPER_INTERVAL=5m
SWEEPER_TTL=24h

# Simulated provider (set SIMULATED_PROVIDER_ENABLED=false to disable)
SIMULATED_PROVIDER_ENABLED=true
PROVIDER_LATENCY_MIN=5ms
PROVIDER_LATENCY_MAX=50ms
PROVIDER_FAILURE_RATE=0.2
PROVIDER_UNAVAILABLE_RATE=0.05
PROVIDER_SEED=42
