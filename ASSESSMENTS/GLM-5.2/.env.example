# Example configuration for notification-service.
# Copy to .env and adjust, or export the variables you need.
# All values are optional; defaults are in internal/config/config.go.

HTTP_ADDR=:8080

QUEUE_CAPACITY=1024
WORKERS=8
RECIPIENT_CONCURRENCY=16

SEND_TIMEOUT=5s
RETRY_ATTEMPTS=3
RETRY_BASE=100ms
RETRY_MAX=2s

CIRCUIT_FAILURES=5
CIRCUIT_COOLDOWN=10s

RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=60

LIST_DEFAULT_LIMIT=20
LIST_MAX_LIMIT=100

# Simulator provider tuning (demonstrates unreliability handling).
PROVIDER_FAILURE_PROB=0.1
PROVIDER_SLOW_PROB=0.1
PROVIDER_SLOW_DELAY=2s
PROVIDER_MIN_DELAY=20ms

LOG_LEVEL=info
